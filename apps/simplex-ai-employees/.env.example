# Copy to .env and fill in. Never commit the filled-in file.

# Admin web UI password (use a long random one) and the in-chat admin token.
AI_ADMIN_PASSWORD=
AI_ADMIN_TOKEN=

# Keys for the models declared in employees.yaml (only the ones you use).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Secrets referenced as ${NAME} in action headers or URLs.
ORDER_WEBHOOK_TOKEN=

# Chat channels (only the ones declared under channels: in employees.yaml).
ZALO_APP_SECRET=
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=
FB_PAGE_TOKEN=
FB_APP_SECRET=
ZALO_OA_SECRET=
WEBCHAT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WAHA_API_KEY=
WAHA_WEBHOOK_HMAC=
EMAIL_INBOUND_KEY=
SMTP_PASSWORD=
# Zalo personal-account gateway (docker compose --profile zalo): two long random strings.
ZALO_GATEWAY_KEY=
ZALO_GATEWAY_HOOK_SECRET=

# Delivery routes (optional): geocoding and driving times.
GOOGLE_MAPS_API_KEY=
# Amazon Selling Partner API (Kho hàng -> Sàn TMĐT), and the public catalog key for your website.
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
CATALOG_KEY=
# The shop's own email (Kho hàng -> Cửa hàng -> Email): the password env var you name there.
SHOP_SMTP_PASSWORD=

# Scale-out (docker compose --profile scale): the shared PostgreSQL.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://aie:CHANGE_ME@postgres:5432/aie

# Online payments (Kho hàng -> Cửa hàng & tích điểm -> Thanh toán online): the variables you name there.
# VNPAY_SECRET=
# MOMO_SECRET=
# ZALOPAY_KEY1=
# ZALOPAY_KEY2=

# Operations (docs/OPERATIONS.md). Nightly backup hour in the office's time zone (default 3),
# and a command that copies each archive off the machine ({file} = the archive's path; no shell):
AI_BACKUP_HOUR=3
#AI_BACKUP_COMMAND=rclone copy {file} remote:aie-backups
# Keep this many days / files of backups in AI_BACKUP_DIR (defaults 14 / 60); AI_BACKUP_ENABLED=0 turns them off.
#AI_BACKUP_KEEP_DAYS=14
#AI_BACKUP_KEEP_COUNT=60
# A long random token enables GET /metrics (Prometheus) on the admin UI: Authorization: Bearer <token>.
AI_METRICS_TOKEN=
