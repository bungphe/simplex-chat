# Copy to .env and fill in. Never commit the filled-in file.

# Admin web UI password (use a long random one) and the in-chat admin token.
AI_ADMIN_PASSWORD=
AI_ADMIN_TOKEN=

# Keys for the models declared in employees.yaml (only the ones you use).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Secrets referenced as ${NAME} in action headers or URLs.
ORDER_WEBHOOK_TOKEN=

# Chat channels (only the ones declared under channels: in employees.yaml).
ZALO_APP_SECRET=
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=
FB_PAGE_TOKEN=
FB_APP_SECRET=
ZALO_OA_SECRET=
WEBCHAT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WAHA_API_KEY=
WAHA_WEBHOOK_HMAC=
EMAIL_INBOUND_KEY=
SMTP_PASSWORD=
# Zalo personal-account gateway (docker compose --profile zalo): two long random strings.
ZALO_GATEWAY_KEY=
ZALO_GATEWAY_HOOK_SECRET=

# Delivery routes (optional): geocoding and driving times.
GOOGLE_MAPS_API_KEY=
# Amazon Selling Partner API (Kho hàng -> Sàn TMĐT), and the public catalog key for your website.
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
CATALOG_KEY=

# Scale-out (docker compose --profile scale): the shared PostgreSQL.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://aie:CHANGE_ME@postgres:5432/aie
